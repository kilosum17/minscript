{
  "name": "minscript",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "ms": "bin/ms.js"
  },
  "description": "MinScript: compiler, JS back end and tools (the `ms` command)",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --test src/*.test.ts test/*.test.ts tools/lsp/*.test.ts",
    "test:update": "UPDATE_SNAPSHOTS=1 node --test src/*.test.ts test/*.test.ts tools/lsp/*.test.ts",
    "test:vscode": "npm --prefix tools/vscode test",
    "lsp": "node tools/lsp/server.ts --stdio",
    "typecheck": "tsc",
    "lex": "node src/cli.ts lex",
    "parse": "node src/cli.ts parse",
    "resolve": "node src/cli.ts resolve",
    "check": "node src/cli.ts check",
    "hir": "node src/cli.ts hir",
    "js": "node src/cli.ts js",
    "run": "node src/cli.ts run",
    "config": "node src/cli.ts config"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.16"
  }
}
