{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MinScript",
  "scopeName": "source.minscript",
  "fileTypes": [
    "ms"
  ],
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#members"
        },
        {
          "include": "#sigils"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#labels"
        },
        {
          "include": "#types"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#identifiers"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#braces"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.minscript",
          "match": "///(?!/).*$"
        },
        {
          "name": "comment.line.double-slash.minscript",
          "match": "//.*$"
        },
        {
          "include": "#block-comment"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.minscript",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.minscript",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.raw.minscript",
          "begin": "(?<![\\w.])(r)(\")",
          "end": "\"",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.minscript"
            },
            "2": {
              "name": "punctuation.definition.string.begin.minscript"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.minscript"
            }
          }
        },
        {
          "name": "string.quoted.double.minscript",
          "begin": "\"",
          "end": "\"|$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.minscript"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.minscript"
            }
          },
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "escape": {
      "patterns": [
        {
          "name": "constant.character.escape.minscript",
          "match": "\\\\(?:[nrt0\\\\\\\"'$]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.minscript",
          "match": "\\\\."
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.minscript",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.minscript"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.minscript"
        }
      },
      "contentName": "source.minscript.embedded",
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "constant.character.minscript",
          "match": "'(?:\\\\(?:[nrt0\\\\\\\"'$]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\})|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.minscript",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.minscript",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.octal.minscript",
          "match": "\\b0o[0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.integer.minscript",
          "match": "(?<=\\.)\\d+"
        },
        {
          "name": "constant.numeric.float.minscript",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?\\b"
        },
        {
          "name": "constant.numeric.float.minscript",
          "match": "\\b\\d[\\d_]*[eE][+-]?\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.minscript",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fun)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.function.minscript"
            },
            "2": {
              "name": "entity.name.function.minscript"
            }
          }
        },
        {
          "match": "\\b(type|union|inter)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.minscript"
            },
            "2": {
              "name": "entity.name.type.minscript"
            }
          }
        },
        {
          "match": "\\b(package)\\s+([A-Za-z_][\\w.]*)",
          "captures": {
            "1": {
              "name": "keyword.other.package.minscript"
            },
            "2": {
              "name": "entity.name.namespace.minscript"
            }
          }
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "name": "entity.name.function.member.minscript",
          "match": "(?<=\\.)[A-Za-z_]\\w*(?=\\s*(?:\\(|\\.\\[))"
        },
        {
          "name": "variable.other.member.minscript",
          "match": "(?<=\\.)[a-z_]\\w*"
        }
      ]
    },
    "sigils": {
      "patterns": [
        {
          "name": "keyword.operator.closure.minscript",
          "match": "#(?=[{\\[])"
        },
        {
          "name": "storage.modifier.sigil.minscript",
          "match": "(?<![\\w.])(?:[rms_](?=\\{)|t(?=\\()|a(?=\\[))"
        },
        {
          "name": "punctuation.accessor.generic.minscript",
          "match": "\\.(?=\\[)"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.declaration.minscript",
          "match": "\\b(?:package|import|pub|type|union|inter|impl|fun|async|let|var|mut|extern)\\b"
        },
        {
          "name": "keyword.control.minscript",
          "match": "\\b(?:if|else|match|select|for|in|break|continue|return|await|or|as)\\b"
        },
        {
          "name": "keyword.other.minscript",
          "match": "\\b(?:unsafe|recover)\\b"
        },
        {
          "name": "constant.language.minscript",
          "match": "\\b(?:true|false|nil)\\b"
        },
        {
          "name": "variable.language.this.minscript",
          "match": "\\b(?:this|Self)\\b"
        },
        {
          "name": "invalid.deprecated.reserved.minscript",
          "match": "\\b(?:while|loop|yield|macro|where|dyn)\\b"
        },
        {
          "name": "support.type.typeof.minscript",
          "match": "\\bTypeOf\\b"
        },
        {
          "name": "invalid.deprecated.attribute.minscript",
          "match": "@\\w+"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.minscript",
          "match": "\\b[a-z_]\\w*(?=:\\s*for\\b)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.minscript",
          "match": "\\b(?:bool|char|byte|i8|i16|i32|i64|u8|u16|u32|u64|isize|usize|int|f32|f64|void|never|string|str)\\b"
        },
        {
          "name": "entity.name.type.minscript",
          "match": "\\b[A-Z]\\w*\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.minscript",
          "match": "\\b[a-z_]\\w*(?=\\s*(?:\\(|\\.\\[))"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.language.implicit.minscript",
          "match": "\\bit(?:[1-9]\\d*)?\\b"
        },
        {
          "name": "variable.other.minscript",
          "match": "\\b[a-z_]\\w*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.binding.minscript",
          "match": ":==|:="
        },
        {
          "name": "keyword.operator.nullish.minscript",
          "match": "\\?\\?=?|\\?\\."
        },
        {
          "name": "keyword.operator.arrow.minscript",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.range.minscript",
          "match": "\\.\\.\\.|\\.\\.=|\\.\\."
        },
        {
          "name": "keyword.operator.comparison.minscript",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.minscript",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.minscript",
          "match": "(?:<<|>>|[-+*/%&|^])?="
        },
        {
          "name": "keyword.operator.minscript",
          "match": "<<|>>|[-+*/%&|^~?]"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.minscript"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.minscript"
        }
      },
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.minscript",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.minscript",
          "match": "\\."
        }
      ]
    }
  }
}
