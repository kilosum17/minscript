(file parser_generics
  (fun identity (generics T) (params (value T)) (-> T) (block value))
  (fun pair (generics A B) (params (a A) (b B)) (-> (t A B)) (block (tuple a b)))
  (fun largest
    (generics (T (PartialOrd T)))
    (params (items (& (Vec T))))
    (-> (& T))
    (block (call (. items max))))
  (fun copy_all (generics (T Reader Writer)) (params (src (&mut T)) (dst (&mut T))) (block))
  (fun trailing (generics T U) (params (x T) (y U)) (block))
  (type Box (generics T) (fields (value T)))
  (type Pair (generics A B) (r (first A) (second B)))
  (union Response (generics T E) (variants (Success T) (Failure E)))
  (inter Convert (generics From To) (fun convert (params &this (value From)) (-> To)))
  (impl (generics T) (Box T) (fun get pub (params &this) (-> (& T)) (block (& (. this value)))))
  (impl
    (generics (T Stringer))
    (Vec T)
    (fun join_all pub
      (params &this)
      (-> string)
      (block (call (. (call (. this map) (closure (call (. it to_str)))) join) ", "))))
  (fun types
    (params
      (a (Vec int))
      (b (Map string (Vec (Option User))))
      (c (Promise (Result User string)))
      (d (Array i32 4))
      (e (std.col.Vec u8))
      (f (Result (Vec (Pair string i64)) string))
      (g (fn (params (Vec int)) (Map string int))))
    (block))
  (fun main
    (params)
    (block
      (let user (call (generic (. json parse) User) json_str))
      (let ids (call (generic collect i64) items))
      (let v1 (call (generic (. Vec new) u8)))
      (let v2 (call (. (generic Vec u8) new)))
      (let m1 (call (. (generic Map string (Vec int)) new)))
      (let b1 (struct (generic Box i32) (value 1)))
      (let p1 (call (generic parse_user User) "{\"id\":1}"))
      (let chained (. (call (. (call (generic (. data decode) Config)) unwrap)) host))
      (let nested (call (generic convert (Vec u8) (Response User string)) bytes))
      (let u (Result User json.Error) (call (. json parse) json_str))
      (let c1 (< a b))
      (let c2 (&& (< a b) (> c d)))
      (let c3 (== (paren (< x y)) true))
      (let i1 (index list 0))
      (let i2 (index (index matrix i) j))
      (let i3 (index (call get_list) 0))
      (let i4 (index map "key")))))
