(file parser_types
  (type User pub
    (impls Stringer)
    (fields
      (pub id u64)
      (pub name string)
      (email (Option string))
      (tags (Vec string) (= (vec)))
      (active bool (= true)))
    (fun new pub (params (id u64) (name string)) (-> User) (block (struct User (id) (name))))
    (fun display_email pub (params &this) (-> (& str)) (block (?? (. this email) "none")))
    (fun rename pub (params &mut this (name string)) (block (= (. this name) name)))
    (fun to_str pub (params &this) (-> string) (block (template "User(" (. this id) ")")))
    (fun refresh pub async (params &mut this) (block (await (call sync (. this id))))))
  (type Compact (fields (x int) (y int)))
  (type Empty (fields))
  (type Several (impls Stringer Clone (PartialEq Several)) (fields (v int)))
  (union Payment pub
    (variants Cash
      (Mpesa string)
      (Card (fields (number string) (exp string)))
      (Split Payment Payment))
    (fun is_cash pub (params &this) (-> bool) (block (match this (=> Cash true) (=> _ false)))))
  (union Inline (variants A B (C int)))
  (union Node
    (generics T)
    (variants (Leaf T) (Branch (fields (left (Box (Node T))) (right (Box (Node T)))))))
  (type Role pub (| "Admin" "Operator" "Guest"))
  (type Code (| 200 404 500))
  (type Bit (| true false))
  (type UserId u64)
  (type Users (Vec User))
  (type Point (r (x f64) (y f64)))
  (type Handler (fn (params Request) Response))
  (type Config (TypeOf default_config))
  (type Fields (KeyOf User))
  (type Route (ElementOf (TypeOf routes)))
  (type List (generics T) (fields (value T) (next (Option (Box (List T))))))
  (fun type_forms
    (params
      (a (& User))
      (b (&mut User))
      (c (*mut u8))
      (d (* u8))
      (e (t int string))
      (f (t))
      (g (r (id int) (name string)))
      (h (fn (params i32 i32) i32))
      (i (& (fn (params i32) i32)))
      (j (fn (params) void))
      (k (fn (params i32) (fn (params i32) i32)))
      (l (Option User))
      (m (Vec (Option User)))
      (n (Option (Vec int)))
      (o (& str))
      (p (Slice u8))
      (q (Array f32 3))
      (s (Promise (Result void string)))
      (u (& Stringer))
      (w (Vec Shape)))
    (-> never)
    (block (call panic "unreachable")))
  (fun returns_fn (params) (-> (fn (params i32) i32)) (block (closure (captures) it)))
  (fun returns_tuple (params) (-> (t int int)) (block (tuple 1920 1080)))
  (fun returns_opt (params) (-> (Option string)) (block nil)))
