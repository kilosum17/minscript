-- trivia --
8:5     line "// interpolation: the lexer keeps a mode stack (string ↔ interpolation, with brace depth)"
11:66   line "// string nested inside ${}"
12:66   line "// interpolation nested twice"
13:77   line "// braces inside ${} don't close it"
16:48   line "// literal text, not interpolation"
17:48   line "// `$` not followed by `{` is literal"
19:5    line "// multi-line: first newline dropped, common indentation (from the closing line) stripped"
27:5    line "// raw: no escapes, no interpolation, may span lines"
32:5    line "// characters"
38:33   line "// char, not a tag (tagged records were removed)"
