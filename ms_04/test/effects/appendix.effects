User.get_name     reads [this.name]  returns_view [this.name]
User.birthday     reads [this.age]  writes [this.age]
User.tag          reads [t, this.tags]  writes [this.tags]  keeps [t]
greet             reads [u.name]
birthday          reads [u.age]  writes [u.age]
with_tag          reads [base, t]  returns_view [base, t]
lex               reads [src]  returns_view [src]
check_ident       reads [id.name, scope]  writes [id.ty]  keeps [scope]  returns_view [scope]
rename            reads [n]  writes [u.name]  keeps [n]
retag             reads [t, u.tags]  writes [u.tags]  keeps [t]
hit               reads [c.hits]  writes [c.hits]
Inventory.at_mut  reads [sku, this.items]  writes [this.items]  keeps [sku]  returns_view [this.items]
restock           reads [inv.items, sku]  writes [inv.items]  keeps [sku]
drain             reads [sub]  writes [sub]  consumes [sub]  awaits
adder             reads [n]  returns_view [n]
each_name         reads [f, users]  invokes [f(users[*].name)]
even              reads [n, xs]  writes [xs]
odd               reads [n, xs]  writes [xs]
