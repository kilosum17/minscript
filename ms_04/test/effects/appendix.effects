appendix.User.get_name     reads [this.name]  returns_view [this.name]
appendix.User.birthday     reads [this.age]  writes [this.age]
appendix.User.tag          reads [t, this.tags]  writes [this.tags]  keeps [t]
appendix.greet             reads [u.name]
appendix.birthday          reads [u.age]  writes [u.age]
appendix.with_tag          reads [base, t]  returns_view [base, t]
appendix.lex               reads [src]  returns_view [src]
appendix.check_ident       reads [id.name, scope]  writes [id.ty]  keeps [scope]  returns_view [scope]
appendix.rename            reads [n]  writes [u.name]  keeps [n]
appendix.retag             reads [t, u.tags]  writes [u.tags]  keeps [t]
appendix.hit               reads [c.hits]  writes [c.hits]
appendix.Inventory.at_mut  reads [sku, this.items]  writes [this.items]  keeps [sku]  returns_view [this.items]
appendix.restock           reads [inv.items, sku]  writes [inv.items]  keeps [sku]
appendix.drain             reads [sub]  writes [sub]  consumes [sub]  awaits
appendix.adder             reads [n]  returns_view [n]
appendix.each_name         reads [f, users]  invokes [f(users[*].name)]
appendix.even              reads [n, xs]  writes [xs]
appendix.odd               reads [n, xs]  writes [xs]
