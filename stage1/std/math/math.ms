package math

pub let pi: f64 = 3.141592653589793
pub let e: f64 = 2.718281828459045

pub fun abs[T](x: T) -> T { _builtin() }
pub fun min[T](a: T, b: T) -> T { _builtin() }
pub fun max[T](a: T, b: T) -> T { _builtin() }
pub fun sqrt(x: f64) -> f64 { _builtin() }
pub fun pow(base: f64, exp: f64) -> f64 { _builtin() }
pub fun floor(x: f64) -> f64 { _builtin() }
pub fun ceil(x: f64) -> f64 { _builtin() }
pub fun round(x: f64) -> f64 { _builtin() }
pub fun sin(x: f64) -> f64 { _builtin() }
pub fun cos(x: f64) -> f64 { _builtin() }
