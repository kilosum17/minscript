(file parser_patterns
  (fun main
    (params)
    (block
      (match value
        (=> 1 "one")
        (=> (- 1) "minus one")
        (=> 1.5 "float")
        (=> "hi" "string")
        (=> 'c' "char")
        (=> true "bool")
        (=> nil "nil")
        (=> _ "anything"))
      (match opt (=> (Some x) x) (=> None 0))
      (match res (=> (Ok (Some v)) v) (=> (Ok None) 0) (=> (Err _) (- 1)))
      (match shape
        (=> (Circle (r)) (* r r))
        (=> (Rect (w width) (h height)) (* width height))
        (=> (Point ..) 0.0)
        (=> (Shape.Line a b) (call (. a dist) b))
        (=> geometry.Shape.Empty 0.0))
      (match n (=> (| 0 1) "tiny") (=> (..= 2 9) "digit") (=> (.. 10 _) "big") (=> _ "negative"))
      (match ch
        (=> (| (..= 'a' 'z') (..= 'A' 'Z')) "letter")
        (=> (..= '0' '9') "digit")
        (=> _ "other"))
      (match tuple (=> (t 0 y) y) (=> (t x 0) x) (=> (t _ _ ..) (- 1)))
      (match rec (=> (r (kind "user") (id)) id) (=> (r (kind) ..) 0))
      (match pair
        (=> (t (Some a) (Some b)) (if (== a b)) "same")
        (=> (t (Some a) _) (if (> a 10)) "big a")
        (=> (t (mut a) b) (block (; (+= a b)) "sum")))
      (match msg
        (=> (Text text) (call (. log println) text))
        (=> (Binary bytes) (call (. log println) (call (. bytes len))))
        (=> Close (block))))))
