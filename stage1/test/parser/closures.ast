(file parser_closures
  (fun main
    (params)
    (block
      (let c1 (closure (* it 2)))
      (let c2 (closure (+ it1 it2)))
      (let c3 (closure (call compute_default)))
      (let c4 (closure))
      (let c5 (closure (params n) (* n n)))
      (let c6 (closure (params n idx) (&& (> n 50) (> idx 0))))
      (let c7 (closure (params mut acc cur) (; (+= acc cur)) acc))
      (let c8 (closure (params (x i32) (y i32)) (+ x y)))
      (let c9 (closure (params (a i32) (b i32)) (-> i32) (+ a b)))
      (let c10 (closure (params (v (Vec i32))) (call (. v len))))
      (let c11 (closure (params (p (t int int))) (+ (. p 0) (. p 1))))
      (let c12 (closure (params (f (& (fn (params i32) i32))) (x i32)) (call f x)))
      (let c13 (closure (params (o (r (a int)))) (. o a)))
      (let c14 (closure (params (u models.User)) (. u name)))
      (let c15 (closure (params (s (Option string))) (?? s "")))
      (let h1 (closure (or (call f) e => (call (. log println) e))))
      (let h2 (closure (match it (=> 0 "zero") (=> _ "other"))))
      (let h3 (closure (if it (block 1) (block 2))))
      (let h4 (closure x))
      (let h5 (closure (+ it 1)))
      (let m1 (closure (params n) (let squared (* n n)) (let offset (+ squared 5)) offset))
      (let m2 (closure (let a it1) (let b it2) (+ a b)))
      (let m3 (closure (params n) (if (< n 0) (block (return 0))) n))
      (let m4 (closure (params x) (; x)))
      (let k1 (closure (captures count) (+ it count)))
      (let k2 (closure (captures &mut total) (+= total it)))
      (let k3 (closure (captures &cfg) (. cfg port)))
      (let k4 (closure (captures) 42))
      (let k5
        (closure
          (captures conn &mut stats)
          (params msg)
          (call (. conn send) msg)
          (+= (. stats sent) 1)))
      (let k6 (closure (captures n) (params (x i32)) (-> i32) (+ x n)))
      (let doubled (call (. numbers map) (closure (* it 2))))
      (let high (call (. numbers filter) (closure (params n idx) (> n 50))))
      (call (. numbers for_each) (closure (captures &mut total) (+= total it)))
      (let n (call adder 10 12 (closure (+ it1 it2))))
      (let sorted
        (call (. users sort_by) (closure (params a b) (call (. (. a age) cmp) (. b age)))))
      (let fallback (call (. timeout or) (closure (call compute_expensive_default))))
      (let nested (call (. groups map) (closure (call (. it filter) (closure (> it 0))))))
      (let nested_named
        (call
          (. groups map)
          (closure (params g) (call (. (. g items) map) (closure (* it (. g factor)))))))
      (let r1 (call (closure (* it 2)) 4))
      (let adder2 (call make_adder 10))
      (let r2 (call adder2 5))))
  (fun make_adder
    (params (n i32))
    (-> (fn (params i32) i32))
    (block (closure (captures n) (+ it n))))
  (fun apply (params (n i32) (f (& (fn (params i32) i32)))) (-> i32) (block (call f n))))
