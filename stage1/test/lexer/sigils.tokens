-- trivia --
3:1     line "// no-glue contexts: a letter after `fun`, `type`, `union`, `inter` is a name, not a sigil"
4:41    line "// IDENT(t) LBRACKET … (not TUPLE_OPEN, not ARRAY_OPEN)"
5:41    line "// IDENT(a) LPAREN"
6:41    line "// IDENT(m) (lowercase type: lint warning, lexes fine)"
11:5    line "// glued sigils: one token each"
12:41   line "// RECORD_OPEN"
13:41   line "// MAP_OPEN"
14:41   line "// SET_OPEN"
15:41   line "// TUPLE_OPEN"
16:41   line "// ARRAY_OPEN (the resolver would also report E_SIGIL_SHADOWS_BINDING because of `fun a` above; lexer tests ignore that)"
17:41   line "// INFERRED_OPEN"
18:41   line "// CLOSURE_OPEN"
19:41   line "// CAPTURE_OPEN IDENT(x) RBRACKET LBRACE(glued)"
20:41   line "// IDENT(f) GENERIC_OPEN IDENT(i32) RBRACKET …"
21:41   line "// RAW_STRING"
22:41   line "// TUPLE_OPEN RPAREN"
23:41   line "// LBRACKET (plain Vec literal, no sigil)"
25:5    line "// not glued: ordinary identifiers"
26:41   line "// IDENT(a) LBRACKET INT RBRACKET  (index)"
27:41   line "// IDENT(t) LPAREN INT RPAREN      (call)"
29:5    line "// the letter is the tail of a longer identifier: no sigil"
30:41   line "// IDENT(data) LBRACKET"
31:41   line "// IDENT(cat) LPAREN"
34:5    line "// after `.`: a member name, never a sigil"
35:41   line "// IDENT DOT IDENT(a) LBRACKET"
36:41   line "// IDENT DOT IDENT(t) LPAREN"
37:41   line "// IDENT DOT IDENT(r)"
39:5    line "// underscore forms"
40:41   line "// IDENT(_unused)"
41:41   line "// `_` alone is the wildcard"
42:41   line "// IDENT(__x)"
44:5    line "// generic args in type position use a glued `[`, not `.[`"
45:41   line "// IDENT LBRACKET IDENT LBRACKET … RBRACKET RBRACKET"
46:41   line "// GENERIC_OPEN IDENT LBRACKET IDENT RBRACKET RBRACKET"
