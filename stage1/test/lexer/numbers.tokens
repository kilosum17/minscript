-- trivia --
4:5     line "// integers"
13:5    line "// floats"
20:5    line "// a `.` belongs to the number only when a digit follows it"
21:29   line "// INT(1) DOTDOT INT(10)"
22:29   line "// INT(1) DOTDOTEQ INT(10)"
23:29   line "// INT(0) DOTDOT IDENT(n)"
24:29   line "// INT(1) DOT IDENT(to_str) LPAREN RPAREN"
25:29   line "// FLOAT(1.5) DOT IDENT(to_str) …"
27:5    line "// after a member `.`, only digits are lexed (tuple indexing)"
28:29   line "// IDENT DOT INT(0)"
29:29   line "// IDENT DOT INT(0) DOT INT(1), never FLOAT(0.1)"
30:29   line "// IDENT DOT INT(1) DOT INT(0) DOT INT(2)"
32:5    line "// unary minus is an operator, not part of the literal"
33:29   line "// MINUS INT(42)"
34:29   line "// MINUS FLOAT(0.5)"
