{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "rootDir": "..",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": true,
        "types": [
            "node","bun"
        ]
    },
    "include": [
        "src/**/*.ts",
        "../syntax/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}